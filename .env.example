# Chave do OpenRouter (obrigatoria para chamar o JEV)
OPENROUTER_API_KEY=

# Modelo JEV fixado (nao usar alias ~typesafe/jev-latest)
JEV_MODEL=typesafe/jev-1.13

# Endpoint System One (Decisions API) do OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api
DECISIONS_PATH=/alpha/decisions

# Privacidade: mascarar PII antes de montar o state
MASK_PII=true

# Execucao
MAX_CONCURRENCY=8
SPEND_CAP_USD=5
